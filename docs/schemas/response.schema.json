{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAG-Edit success response",
  "type": "object",
  "required": [
    "ok",
    "operation"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "rewrite",
        "read",
        "search",
        "replace",
        "insert",
        "delete"
      ]
    }
  },
  "additionalProperties": true
}
